# Django settings. -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ------------ Caddy settings. -------------------------------------------------------------
COMPOSE_PROFILES=caddy
CADDY_SITE_ADDRESS=:80
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ------------ Optional second public site (Mini App etc.). Do not set these to empty strings —
# leave both commented, or set both to real values.
# CADDY_EXTRA_SITE_ADDRESS=app.example.com
# CADDY_EXTRA_UPSTREAM=menu-telegram:8090

# ------------ External proxy settings. -------------------------------------------------------------
EXTERNAL_PROXY_BIND_ADDRESS=127.0.0.1
EXTERNAL_PROXY_HTTP_PORT=8080

# ------------ Django settings. -------------------------------------------------------------
# Enable HTTPS.
DJANGO_ENABLE_HTTPS=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=20971520
# Login rate limit.
# How many login attempts to allow in the given time window.
LOGIN_RATE_LIMIT_COUNT=10
# How long to consider a login attempt. (seconds)
LOGIN_RATE_LIMIT_WINDOW=300

# ------------ Postgres settings. -------------------------------------------------------------
POSTGRES_DB=menu_autoprint
POSTGRES_USER=menu_autoprint
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------ Backup settings. -------------------------------------------------------------
# How often to backup. (days)
BACKUP_INTERVAL_DAYS=10
# How many backups to keep.
BACKUP_KEEP=3
# How long to wait before starting the backup. (seconds)
BACKUP_START_DELAY_SECONDS=300
# How long to keep the menu archive. (days)
MENU_ARCHIVE_RETENTION_DAYS=730
# How much space to leave in the menu archive. (bytes)
MENU_ARCHIVE_LOW_SPACE_BYTES=2147483648

# ------------ Azure Translator. -------------------------------------------------------------
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_SOURCE_LANG=ru
AZURE_TRANSLATOR_TARGET_LANG=en
TZ=Europe/Moscow

# ------------ Integration settings. -------------------------------------------------------------
INTEGRATION_API_ENABLED=0
INTEGRATION_SERVICE_USER_ID=
INTEGRATION_API_KEY_HASH=
# How long to keep an integration operation. (hours)
INTEGRATION_OPERATION_TTL_HOURS=24
